{
  "name": "repo-template-service-express",
  "version": "0.1.0",
  "private": true,
  "description": "Generalized service template using Node.js, TypeScript, and Express.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "4.21.2",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.7.0"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.13.10",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.26.0",
    "@typescript-eslint/parser": "8.26.0",
    "eslint": "9.21.0",
    "prettier": "3.5.2",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  },
  "packageManager": "pnpm@10.6.3"
}
